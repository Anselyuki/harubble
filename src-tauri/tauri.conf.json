{
  "productName": "Harubble",
  "version": "2.2.0",
  "identifier": "com.harubble.app",
  "build": {
    "beforeBuildCommand": "bun run build",
    "beforeDevCommand": "bun run build && bun run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Harubble",
        "width": 1120,
        "height": 800,
        "minWidth": 1120,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://monster-siren.hypergryph.com https://web.hycdn.cn https://static.hycdn.cn data:; connect-src 'self' ipc://localhost https://monster-siren.hypergryph.com; script-src 'self'; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/image-cache/**",
          "$APPDATA/_cache_fallback/image-cache/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
